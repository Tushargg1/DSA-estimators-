# Base URL of the Spring Boot REST API. Vercel production builds require HTTPS.
VITE_API_BASE_URL=http://localhost:8080/api

# SockJS uses an HTTP(S) endpoint, not ws:// or wss://. Production uses HTTPS.
VITE_WS_URL=http://localhost:8080/ws

# Public Google OAuth 2.0 Web application client ID (never a client secret).
# This must match the backend GOOGLE_CLIENT_ID value.
VITE_GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com
