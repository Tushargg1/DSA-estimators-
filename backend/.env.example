# DSA Progress Tracker backend environment template.
# Copy to .env for local use. Never commit real credentials.

# Local MySQL 8 defaults (root docker-compose.yml).
DB_URL=jdbc:mysql://localhost:3306/dsatracker?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USERNAME=dsatracker
DB_PASSWORD=dsatracker

# Aiven example (placeholders only; TLS encryption required):
# DB_URL=jdbc:mysql://<host>:<port>/<database>?sslMode=REQUIRED&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
# DB_USERNAME=<username>
# DB_PASSWORD=<password>
# Optional conservative Hikari pool sizing for free-tier connection limits.
DB_POOL_MAX=5
DB_POOL_MIN_IDLE=1

# Explicit browser origins are required in production; never use "*" while
# credentialed CORS is enabled.
CORS_ALLOWED_ORIGINS=http://localhost:5173
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:5173

# Render injects PORT automatically. SERVER_PORT is used by other environments
# and as the fallback when PORT is absent.
SERVER_PORT=8080
