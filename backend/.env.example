# =============================================================================
# DSA Progress Tracker — backend environment variables (task 12.4)
#
# Copy to `.env` and fill in real values for your environment. These map to
# properties in application.yml via Spring's relaxed binding (e.g.
# CORS_ALLOWED_ORIGINS -> cors.allowed-origins and WEBSOCKET_ALLOWED_ORIGINS ->
# websocket.allowed-origins). Do NOT commit a real `.env`.
# =============================================================================

# --- Database (Postgres) ----------------------------------------------------
# JDBC URL, user, and password for the Postgres instance. Locally these default
# to the docker-compose service; in deployment point them at your managed
# Postgres (Neon/Supabase/Railway — see task 12.3).
DB_URL=jdbc:postgresql://localhost:5432/dsatracker
DB_USERNAME=dsatracker
DB_PASSWORD=dsatracker

# --- CORS (REST API, applied to /api/**) ------------------------------------
# Comma-separated list of allowed browser origins for the REST API.
# SECURITY: set the explicit frontend origin(s) in production — never "*",
# because CORS credentials are enabled.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- WebSocket (/ws STOMP handshake) ----------------------------------------
# Comma-separated list of allowed origins for the WebSocket handshake.
# SECURITY: set the explicit frontend origin(s) in production — never "*".
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:5173

# --- HTTP server ------------------------------------------------------------
# Port the backend listens on (matches EXPOSE 8080 in the Dockerfile).
SERVER_PORT=8080
