# DSA Progress Tracker backend environment template.
# Copy to .env for local use. Never commit real credentials.

# Local MySQL 8 defaults (root docker-compose.yml).
DB_URL=jdbc:mysql://localhost:3306/dsatracker?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USERNAME=dsatracker
DB_PASSWORD=dsatracker

# Aiven example (placeholders only; TLS encryption required):
# DB_URL=jdbc:mysql://<host>:<port>/<database>?sslMode=REQUIRED&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
# DB_USERNAME=<username>
# DB_PASSWORD=<password>
# Optional conservative Hikari pool sizing for free-tier connection limits.
DB_POOL_MAX=5
DB_POOL_MIN_IDLE=1

# Explicit browser origins are required in production; never use "*".
CORS_ALLOWED_ORIGINS=http://localhost:5173
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:5173

# Production: generate a random secret containing at least 32 bytes. The
# application.yml fallback is local/test-only and must never be used in production.
AUTH_JWT_SECRET=<random-32-plus-byte-secret>
AUTH_JWT_ISSUER=dsa-tracker
AUTH_JWT_AUDIENCE=dsa-tracker-web
AUTH_JWT_EXPIRY=PT12H

# Public OAuth 2.0 Web application client ID. Use the same value as the
# frontend's VITE_GOOGLE_CLIENT_ID; this is not a client secret.
GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com

# Optional, temporary operator-assisted activation code for pre-auth accounts.
# Leave unset to disable the endpoint; remove it after legacy accounts activate.
# LEGACY_ACCOUNT_SETUP_SECRET=<temporary-random-setup-code>

# Render injects PORT automatically. SERVER_PORT is used by other environments
# and as the fallback when PORT is absent.
SERVER_PORT=8080

# Public, non-commercial Leetcode Patterns catalog sync (CC BY-NC 4.0).
CATALOG_QUESTIONS_URL=https://raw.githubusercontent.com/SeanPrashad/leetcode-patterns/main/src/data/questions.json
CATALOG_ROADMAPS_URL=https://raw.githubusercontent.com/SeanPrashad/leetcode-patterns/main/src/data/roadmaps.ts
CATALOG_SYNC_ENABLED=true
CATALOG_SYNC_CRON=0 0 3 * * MON
CATALOG_SYNC_ZONE=UTC
